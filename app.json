{
  "expo": {
    "name": "dtrack",
    "slug": "dtrack",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dtrack.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.dtrack.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "@rnmapbox/maps/app.plugin.js",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow dtrack to access your location for tracking.",
          "locationAlwaysPermission": "Allow dtrack to access your location in the background.",
          "locationWhenInUsePermission": "Allow dtrack to access your location.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e9feb574-65ff-4472-b7fb-c6a3a2e3f48a"
      }
    }
  }
}
